{
  "name": "tryitjs",
  "version": "1.0.0",
  "description": "Generate JS Library Tutorial as a standalone HTML file from extended markdown file, with runnable and editable code snippets",
  "main": "index.js",
  "scripts": {
    "start": "reload -d . -e try,html,css,js -w try_it -v -b -s index.html",
    "tryit": "node bin/gen-tryit.js --src try_src --dest try_it --filelist",
    "tryit:local": "rollup -c && node bin/gen-tryit.js --src try_src --dest try_it --local --filelist",
    "test": "echo \"Error: no test specified\" && exit 1",
    "tryit:dev": "nodemon -w try_src --ext \"try js css\"   bin/gen-tryit.js --src try_src --dest try_it --local --filelist",
    "build": "rollup -c && npm pack && npm install -g tryitjs-1.0.0.tgz && npm run tryit",
    "watch": "nodemon -w \"lib ref_src\" --ext \"try js css\" --exec \"npm run build\""
  },
  "bin": {
    "tryitjs": "bin/gen-tryit.js"
  },
  "eslintConfig": {
    "globals": {
      "CodeMirror": true,
      "tryit$colors": true,
      "sha1": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nurulc/tryitjs.git"
  },
  "keywords": [
    "generate",
    "html",
    "editable",
    "javascript",
    "code",
    "IDE"
  ],
  "author": "Nurul Choudhury",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nurulc/tryitjs/issues"
  },
  "homepage": "https://github.com/nurulc/tryitjs#readme",
  "devDependencies": {
    "@babel/preset-env": "^7.25.4",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "babel-plugin-loop-optimizer": "^1.4.1",
    "babel-plugin-minify-dead-code-elimination": "^0.5.2",
    "glob": "^10.3.0",
    "json-to-ast": "^2.1",
    "nodemon": "^3.1",
    "reload": "^3.3.0",
    "rollup": "^4.22.4",
    "rollup-plugin-filesize": "^10.0.0",
    "rollup-plugin-progress": "^1.1.2",
    "rollup-plugin-visualizer": "^5.12.0"
  },
  "dependencies": {
    "directory-tree": "^3.5",
    "highlight.js": "^11.10",
    "json5": "^2.2.3",
    "showdown": "^2.1.0"
  }
}
